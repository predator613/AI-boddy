# Адрес backend. В Docker и локально по умолчанию http://localhost:8080
VITE_API_URL=http://localhost:8080
# true – запросы перехватывают моки MSW (когда backend не запущен)
VITE_USE_MOCKS=false
# false – выключить моки для эндпоинтов, которых еще нет в backend (чат, заявки, справочник)
VITE_PENDING_MOCKS=true
