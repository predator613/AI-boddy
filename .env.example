# Пример настроек AI-buddy без секретов. Скопируйте в .env и при необходимости поменяйте:
#   cp .env.example .env
# Файл .env не обязателен: без него все работает со значениями по умолчанию из docker-compose.yml.
# Сам .env с ключами в репозиторий не попадает (.gitignore).

# --- Языковая модель -------------------------------------------------------
# mock – офлайн-режим без ключа и сети: весь сценарий работает, ответы проще.
# openai_compat – любая OpenAI-совместимая модель с function calling (подробно: docs/llm-setup.md).
LLM_PROVIDER=mock
# Адрес API, оканчивается на /v1. Например, Yandex AI Studio: https://llm.api.cloud.yandex.net/v1
LLM_BASE_URL=
# Ключ API (не коммитить!)
LLM_API_KEY=
# Имя модели. Например, для Yandex AI Studio: gpt://<ID каталога>/yandexgpt/latest
LLM_MODEL=
# ID каталога, только для Yandex AI Studio
LLM_PROJECT=
# Сколько ждать модель, потом ответ собирается офлайн
LLM_TIMEOUT=20s

# --- Безопасность и вход ---------------------------------------------------
# Ключ подписи токенов, не короче 16 символов. Для демо подойдет значение по умолчанию.
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_TTL=24h
# true – на странице входа карточки тестовых пользователей
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Имитация корпоративных сервисов (Jira Service Desk) -------------------
# Через сколько имитация сама «согласует» обычную заявку.
# Заявку, которую решает человек (руководитель), – через 6 таких интервалов, если он не успел.
MOCK_DECISION_DELAY=45s
# Как часто backend забирает решения по заявкам
REQUEST_SYNC_INTERVAL=5s

# --- База данных -----------------------------------------------------------
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=ai_buddy

# --- Порты на компьютере ---------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
MOCK_SERVICES_PORT=8090
POSTGRES_PORT=5432
REDIS_PORT=6379
# Адрес backend для сборки фронта
VITE_API_URL=http://localhost:8080
