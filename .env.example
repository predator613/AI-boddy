# Скопируйте в .env и при необходимости поменяйте. Без .env тоже работает (значения по умолчанию в docker-compose.yml).
# Секретов здесь нет: все значения – только для локального демо.

# --- PostgreSQL ---
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=ai_buddy
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8080
# Строка не короче 16 символов. Для любого не-демо окружения обязательно заменить.
JWT_SECRET=dev-only-secret-change-me-0123456789
# Срок жизни токена: 30m, 24h и т.п.
JWT_TTL=24h
# true – работает GET /api/auth/test-users (карточки для быстрого входа)
DEMO_MODE=true
# Адреса фронта через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM (следующий этап, сейчас не используется) ---
# LLM_PROVIDER=mock
# LLM_API_KEY=
